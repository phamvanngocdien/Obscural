# ============================================================
# Obscural Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ── Frontend (Vite) ──
VITE_PRIVY_APP_ID=your_privy_app_id
VITE_API_URL=http://localhost:3001
VITE_INVOICE_FACTORY_ADDRESS=0x...
VITE_ESCROW_VAULT_ADDRESS=0x...
VITE_BILL_SPLITTER_ADDRESS=0x...
VITE_CHAIN_ID=11155111

# ── Backend (Express) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
GEMINI_API_KEY=your_gemini_api_key
FRONTEND_URL=http://localhost:5173
PORT=3001

# ── OnLatch (AI Agent Governance — optional) ──
LATCH_TOKEN=lat_your_latch_token
LATCH_PROXY_URL=https://onlatch.com/proxy

# ── Contracts (Foundry — optional, for deployment) ──
SEPOLIA_RPC_URL=https://rpc.sepolia.org
PRIVATE_KEY=your_deployer_private_key
